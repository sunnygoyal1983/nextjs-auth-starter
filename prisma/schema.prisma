generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}
model User {
    id Int @id @default(autoincrement())
    name String
    email String @unique
    password String
    role String @default("USER")
    isVerified Boolean @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

enum Role {
    USER
    ADMIN
}